# PlatformIO build output and IDE integration
.pio/
.vscode/
.gcc-flags.json
compile_commands.json

# ESP-IDF generated config: sdkconfig.defaults is the source of truth,
# the per-environment sdkconfig is regenerated from it on build.
firmware/sdkconfig.*
!firmware/sdkconfig.defaults
!firmware/sdkconfig.defaults.esp32c3
firmware/sdkconfig
firmware/sdkconfig.old
firmware/test/nomad_lr1121/sdkconfig.*
!firmware/test/nomad_lr1121/sdkconfig.defaults
firmware/managed_components/
firmware/dependencies.lock

# Host test build products (make -C firmware/test/host)
firmware/test/host/test_decoder
firmware/test/host/ui_preview
firmware/test/host/*.pgm
firmware/test/host/shots/

# Local flash backup of the original firmware (kept out of git)
backup/

# Python bytecode
__pycache__/
*.py[cod]

# Local Wi-Fi / MQTT credentials (template: firmware/src/wifi_config.example.h)
firmware/src/wifi_config.h
tools/watch-runs/
