# ESP32-C3 + LR1121 board, on top of sdkconfig.defaults (ESP-IDF loads
# sdkconfig.defaults.<target> automatically).

# Console + logs on UART0 (GPIO21 TX / GPIO20 RX) to the external USB-TTL
# adapter. The built-in USB-Serial-JTAG isn't wired, so no secondary console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Smaller image: optimize for size, assert() without file/condition text, and
# no debug-level log strings (the CLI 'log' command tops out at info).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# Features this firmware doesn't use: WPA2-Enterprise, MQTT over TLS or
# WebSocket (it connects with plain mqtt://), and IPv6.
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_MQTT_TRANSPORT_SSL is not set
# CONFIG_MQTT_TRANSPORT_WEBSOCKET is not set
# CONFIG_LWIP_IPV6 is not set
