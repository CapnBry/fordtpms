# Shared by both boards; sdkconfig.defaults.esp32c3 adds the C3 board's settings.

# 4 MB flash (ESP32-WROOM-32, ESP32-C3 embedded flash)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Console + logs on UART0, the UART wired to the USB bridge (ESP32: GPIO1/GPIO3)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_COLORS=y

CONFIG_FREERTOS_HZ=1000

# CPU frequency scaling (configured in app_main)
CONFIG_PM_ENABLE=y

# Two 1700 KB OTA app slots: Wi-Fi + web UI + MQTT need more than 1 MB, and the
# second slot leaves room to add OTA updates without repartitioning. NVS stays
# at 0x9000 (24 KB), so saved settings survive the change.
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y

# Web UI live updates
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# Smaller image: optimize for size, assert() without file/condition text.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
